# Copy to .env.local; never commit real values.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after Google is configured in Supabase Authentication > Providers.
GOOGLE_AUTH_ENABLED=true
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=
# DATABASE_PATH removed — database is now Supabase Postgres (configured via SUPABASE_SECRET_KEY below)

# Admin dashboard. Server-only: never prefix these with NEXT_PUBLIC_.
ADMIN_EMAIL=dipanshu.niat@gmail.com
# Bound to the verified Supabase user UUID; blank means no admin access.
ADMIN_USER_ID=
# Supabase secret key (service-role key) — used as the database client on the server.
SUPABASE_SECRET_KEY=
